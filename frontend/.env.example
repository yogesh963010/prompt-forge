# PromptForge Frontend Environment Configuration Template
#
# VITE_API_URL — Leave empty when using the Vite dev proxy (recommended).
# The proxy in vite.config.ts automatically forwards /auth, /prompt-systems,
# /modules, /providers to http://127.0.0.1:8000 on the local machine.
#
# Only set this if you are pointing the frontend at a remote backend server:
# VITE_API_URL=https://api.yourserver.com
VITE_API_URL=
