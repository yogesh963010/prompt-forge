# Environment Configuration Example
# Copy this file to .env and fill in your actual credentials

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/promptforge

# JWT Configuration
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# RAG Configuration
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b
STORAGE_DOCUMENTS_DIR=storage/documents
STORAGE_VECTORSTORE_DIR=storage/vectorstore

# BYOK — API Key Encryption (Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER commit the real key to Git.
CREDENTIAL_ENCRYPTION_KEY=your-fernet-key-here
